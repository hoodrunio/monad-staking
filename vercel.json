{
  "version": 2,
  "builds": [
    {
      "src": "apps/staking-web/package.json",
      "use": "@vercel/next",
      "config": {
        "distDir": ".next"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/staking-web/$1"
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter '@monad-staking/config' build && pnpm --filter '@monad-staking/sdk' build"
}
