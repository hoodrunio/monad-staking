{
  "name": "@monad-staking/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for interacting with Monad blockchain staking precompile",
  "author": "HoodRun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoodrunio/monad-staking.git",
    "directory": "packages/monad-staking-sdk"
  },
  "homepage": "https://github.com/hoodrunio/monad-staking#readme",
  "bugs": {
    "url": "https://github.com/hoodrunio/monad-staking/issues"
  },
  "keywords": ["monad", "blockchain", "staking", "sdk", "ethereum", "viem"],
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "pnpm vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monad-staking/config": "workspace:*",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
