{
  "name": "monad-staking",
  "private": true,
  "version": "0.1.0",
  "description": "Monad staking dApp monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "onchain/*"
  ],
  "engines": {
    "node": ">=18.18",
    "pnpm": ">=8.9"
  },
  "scripts": {
    "build": "pnpm --filter '@monad-staking/config' build && pnpm --filter '@monad-staking/sdk' build && pnpm --filter '@monad-staking/staking-web' build",
    "build:all": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.4.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "viem": "^2.30.0"
  },
  "pnpm": {
    "allowedBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "keccak",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
